FROM node:20-alpine AS build
WORKDIR /workspace
COPY package.json package-lock.json* ./
COPY apps/cache-demo/package.json apps/cache-demo/package.json
RUN npm install
COPY apps/cache-demo apps/cache-demo
WORKDIR /workspace/apps/cache-demo
RUN npm run build:api
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node","dist/main.js"]