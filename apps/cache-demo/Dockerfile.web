FROM node:20-alpine AS build
WORKDIR /workspace
COPY package.json ./
COPY apps/cache-demo/package.json apps/cache-demo/package.json
RUN npm install
COPY apps/cache-demo apps/cache-demo
WORKDIR /workspace/apps/cache-demo
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build:web
FROM nginx:1.27-alpine
COPY apps/cache-demo/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/cache-demo/web/dist /usr/share/nginx/html
EXPOSE 80