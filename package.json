{"name":"realtime-batch-monitor","private":true,"version":"1.0.0","workspaces":["apps/*"],"scripts":{"dev":"concurrently -k \"npm:dev:api\" \"npm:dev:desktop\"","dev:api":"npm --workspace @rbm/api run start:dev","dev:desktop":"npm --workspace @rbm/desktop run dev","build":"npm run build:api && npm run build:desktop","build:api":"npm --workspace @rbm/api run build","build:desktop":"npm --workspace @rbm/desktop run build"},"devDependencies":{"concurrently":"^9.1.2"}}